# Copy to .env and fill in. Vite only injects VITE_* into the bundle.

# ---- TMDB (required: catalog, images and search) ----
# https://www.themoviedb.org/settings/api
VITE_TMDB_BEARER_TOKEN=

# ---- Vimeus (player) ----
# https://vimeus.net/settings/general
VITE_VIMEUS_VIEW_KEY=

# ---- Server only: read by server.ts from the Deno environment, never bundled ----
VIMEUS_API_KEY=

# ---- Python API (api/main.py) ----
# Optional. When set, every data endpoint requires the X-API-Key header.
VUMIES_API_KEY=
