# This project uses pnpm exclusively.
# engine-strict makes npm/yarn fail on the "engines" field of package.json.
engine-strict=true

# Do not auto-provision the pnpm version from the "packageManager" field:
# On Deno Deploy that mechanism tried to install pnpm 11.2.2 and broke (`dist/pnpm.mjs` not found).
manage-package-manager-versions=false
